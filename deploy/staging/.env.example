# Salin ke deploy/staging/.env DI SERVER STAGING (jangan di-commit). deploy.sh menolak jalan tanpa file ini.
# Rahasia: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Alamat publik API (domain Cloudflare → API :4000 di Mac mini). Dashboard web dibangun dengan nilai ini.
PUBLIC_API_URL=https://api-precare.adamlabs.dev

POSTGRES_USER=precare
POSTGRES_PASSWORD=
POSTGRES_DB=precare

API_PUBLIC_URL=https://api-precare.adamlabs.dev
CORS_ORIGINS=https://precare.adamlabs.dev,http://10.8.0.246:3100

JWT_ACCESS_SECRET=
JWT_RESET_SECRET=
FILE_URL_SECRET=
# 32 byte base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
HASH_PEPPER=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
GOOGLE_CLIENT_IDS=
GOOGLE_MAPS_API_KEY=
DISPATCH_OFFER_TIMEOUT_SECONDS=60
DISPATCH_ESCALATE_AFTER_SECONDS=180
DISPATCH_UNSERVED_AFTER_SECONDS=600
DISPATCH_REQUIRE_CREW_ON_DUTY=true
SIMRS_HTTP_TIMEOUT_MS=5000
SIMRS_RECHECK_INTERVAL_MINUTES=10
