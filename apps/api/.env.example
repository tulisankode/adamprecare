NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

DATABASE_URL=postgresql://precare:precare@127.0.0.1:55432/precare?schema=public
REDIS_URL=redis://127.0.0.1:56379

# Rahasia (wajib diganti di produksi): string acak >= 32 karakter
JWT_ACCESS_SECRET=
JWT_RESET_SECRET=
FILE_URL_SECRET=
# 32 byte base64 untuk enkripsi kolom (NIK, kredensial integrasi)
DATA_ENCRYPTION_KEY=
HASH_PEPPER=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

UPLOAD_DIR=./uploads

# Google Sign-In (opsional): daftar client ID dipisah koma
GOOGLE_CLIENT_IDS=
# Google Maps Platform (opsional). Kosong = geocoding via OpenStreetMap Nominatim & ETA estimasi garis lurus
GOOGLE_MAPS_API_KEY=

# Dispatch (detik)
DISPATCH_OFFER_TIMEOUT_SECONDS=60
DISPATCH_ESCALATE_AFTER_SECONDS=180
DISPATCH_UNSERVED_AFTER_SECONDS=600

# SIMRS
SIMRS_HTTP_TIMEOUT_MS=5000
SIMRS_RECHECK_INTERVAL_MINUTES=10
