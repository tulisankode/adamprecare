{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "[.]e2e-spec[.]ts$",
  "transform": {
    "^.+[.]ts$": "ts-jest"
  },
  "setupFiles": [
    "<rootDir>/test/setup-env.ts"
  ],
  "globalSetup": "<rootDir>/test/global-setup.ts",
  "testTimeout": 60000
}
